# Copy to .env.local for local development. Never commit real values.
# Generate secrets with: openssl rand -base64 32

# Supabase Postgres, pooled connection string. The app does not use a server master key for user secrets.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# GitHub OAuth app. Callback: https://llaverito-alpha.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret

# Better Auth session signing secret. At least 32 characters.
# Production: set this on Vercel. Preview: set it too (a different value is fine).
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32

# Canonical app URL. Local: http://localhost:3000
# Vercel Production: https://your-domain
# Vercel Preview: leave UNSET so each preview host is accepted from the request.
BETTER_AUTH_URL=http://localhost:3000

# Not used for user secrets. Those are encrypted in the browser with a password plus a Secret Key
# that is never sent to Supabase. Leave this unset.
