# Copy to .env.local for local development. Never commit real values.
# Generate secrets with: openssl rand -base64 32

# Neon Postgres connection string (pooled). Vercel Marketplace injects DATABASE_URL.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# Better Auth session signing secret. At least 32 characters.
# Production: set this on Vercel. Preview: set it too (a different value is fine).
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32

# Canonical app URL. Local: http://localhost:3000
# Vercel Production: https://your-domain
# Vercel Preview: leave UNSET so each preview host is accepted from the request.
BETTER_AUTH_URL=http://localhost:3000

# 32-byte master key, base64-encoded (openssl rand -base64 32).
# App-level envelope encryption. Never commit. Rotating it makes existing secrets unreadable.
ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
