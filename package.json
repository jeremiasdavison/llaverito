{
  "name": "llaverito",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node --experimental-strip-types --import ./scripts/register-hooks.mjs scripts/migrate.ts --if-configured && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-repo.mjs",
    "test": "node --experimental-strip-types --import ./scripts/register-hooks.mjs --experimental-test-isolation=process --conditions=react-server --test test/**/*.test.ts",
    "db:migrate": "node --experimental-strip-types --import ./scripts/register-hooks.mjs scripts/migrate.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "ws": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3"
  }
}
